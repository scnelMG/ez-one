[Unit]
Description=EZ-ONE Spring Boot Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ezone
Group=ezone
WorkingDirectory=/opt/ez-one/backend
EnvironmentFile=/etc/ez-one/ez-one.prod.env
ExecStart=/usr/bin/java -jar /opt/ez-one/backend/app.jar
Restart=on-failure
RestartSec=10
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
